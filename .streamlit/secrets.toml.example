# Copy this file to `.streamlit/secrets.toml` and fill in values.
# Never commit `secrets.toml` (it is gitignored).

[auth]
password = "change-me"

[anthropic]
api_key = "sk-ant-api03-..."

# Optional. Required to enable Google Docs (Connect Google + Drive picker).
# Create an OAuth web client and Picker API key in Google Cloud. Redirect URIs:
#   http://localhost:8501
#   https://customizer.schmidlin.casa
[google]
client_id = ".....apps.googleusercontent.com"
client_secret = "..."
api_key = "..."
app_id = "..."
# Optional override; otherwise the app uses the current request origin.
# redirect_uri = "http://localhost:8501"
